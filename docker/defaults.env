# Defaults for the Docker stack (no secrets here). Override with an optional .env.docker.
APP_NAME=HeatAlert
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=heatalert_db
DB_USERNAME=root
DB_PASSWORD=secret

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database
MAIL_MAILER=log

# First start: run the migrations, then load the demo data if the database is empty.
RUN_MIGRATIONS=true
RUN_SEEDER=true
