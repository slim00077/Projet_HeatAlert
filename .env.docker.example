# Copy to .env.docker and adjust: cp .env.docker.example .env.docker
APP_NAME=HeatAlert
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=heatalert_db
DB_USERNAME=root
DB_PASSWORD=secret

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database
MAIL_MAILER=log

# Optional: enables the live AI heat advisor (otherwise rule-based advice is used)
ANTHROPIC_API_KEY=
