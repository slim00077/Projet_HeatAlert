# OPTIONAL. The Docker stack works without this file (defaults are in docker/defaults.env).
# Copy to .env.docker only to add your own keys or mail settings:  cp .env.docker.example .env.docker
# Values here override the defaults.

# Live AI heat advisor (otherwise rule-based advice is used)
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Real emails (otherwise they are written to the application log)
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS="noreply@heatalert.test"
