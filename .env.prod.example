# Copy to .env.prod on the server and edit. Never commit .env.prod.
# GitHub repository in lowercase: owner/name
GHCR_REPOSITORY=slim00077/projet_heatalert
IMAGE_TAG=latest

# Public address of the site (used in links and emails)
APP_URL=http://YOUR_SERVER_IP

# Choose a strong password
DB_DATABASE=heat_alert
DB_PASSWORD=change-me

# Optional: live AI advisor and real emails
GEMINI_API_KEY=
